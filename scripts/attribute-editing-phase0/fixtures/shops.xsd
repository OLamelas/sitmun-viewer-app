<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:gml="http://www.opengis.net/gml" xmlns:menorca="http://menorca" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="http://menorca">
  <xsd:import namespace="http://www.opengis.net/gml" schemaLocation="http://geoserver.local:8080/geoserver/schemas/gml/3.1.1/base/gml.xsd"/>
  <xsd:complexType name="shopsType">
    <xsd:complexContent>
      <xsd:extension base="gml:AbstractFeatureType">
        <xsd:sequence>
          <xsd:element maxOccurs="1" minOccurs="0" name="gid" nillable="true" type="xsd:int"/>
          <xsd:element maxOccurs="1" minOccurs="1" name="category" nillable="false" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="1" name="city" nillable="false" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="1" name="municipality" nillable="false" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="employees" nillable="true" type="xsd:int"/>
          <xsd:element maxOccurs="1" minOccurs="1" name="scope" nillable="false" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="1" name="geom" nillable="false" type="gml:PointPropertyType"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:element name="shops" substitutionGroup="gml:_Feature" type="menorca:shopsType"/>
</xsd:schema>
